{
  "skill_info": {
    "nom": "Analyse de Relevé de Carrière Retraite",
    "version": "2.0",
    "date": "2025-11-10",
    "base_reglementaire": "Circulaire CNAV 2024 | Décret n°2023-436 du 03/06/2023 | Loi n°2023-270 du 14/04/2023",
    "token_estimate_md": 5800,
    "token_estimate_json": 3200,
    "token_estimate_total": 9000
  },
  
  "declencheurs": [
    "releve carriere",
    "releve de carriere",
    "analyse carriere",
    "analyse situation retraite",
    "RIS",
    "age depart",
    "trimestres valides",
    "pension estimee",
    "PROMPT 1"
  ],
  
  "methodologie": {
    "etape_0_emploi_actuel": {
      "question_obligatoire": "Êtes-vous actuellement en activité professionnelle ? Si oui, jusqu'à quel âge envisagez-vous de travailler ?",
      "pourquoi_essentiel": "Un relevé de carrière est une photographie à un instant T. Si la personne continue à travailler, elle acquiert de nouveaux trimestres. L'analyse sans projection future serait complètement erronée.",
      "calcul_projection": {
        "formule": "trimestres_futurs = (age_depart_prevu - age_actuel) × 4",
        "total": "trimestres_totaux = trimestres_actuels + trimestres_futurs"
      },
      "expliciter_hypothese": "Hypothèse : En poursuivant votre activité jusqu'à [âge], vous validerez environ [X] trimestres supplémentaires, portant votre total à [Y] trimestres."
    },
    
    "etape_1_extraction_donnees": {
      "informations_a_extraire": [
        "Date de naissance (NSS ou mention explicite)",
        "Génération",
        "Trimestres validés actuels (tous régimes confondus)",
        "Trimestres cotisés stricts",
        "Trimestres réputés cotisés (service national, chômage, maladie, maternité)",
        "Régimes de cotisation (CNAV, AGIRC-ARRCO, IRCANTEC, RCI, autres)",
        "Périodes de carrière (employeurs, dates)",
        "Périodes à l'étranger",
        "Périodes de chômage, maladie, maternité",
        "Trous de carrière (lacunes)",
        "Anomalies éventuelles",
        "Indicateurs carrière longue (trimestres avant 16/18/20/21 ans)"
      ],
      "action_automatique": "Si trimestres validés avant 20 ans détectés → Déclencher automatiquement SKILL_racl.md"
    },
    
    "etape_2_calcul_ages_cles": {
      "module_python": "calcul_pension_base.py",
      "fonctions_principales": [
        "determiner_age_legal_depart(date_naissance)",
        "obtenir_duree_assurance_requise(date_naissance)",
        "calculer_date_effet_retraite(date_naissance)"
      ],
      "ages_a_calculer": [
        "Âge légal de départ (variable selon génération)",
        "Trimestres requis pour le taux plein",
        "Date du taux plein automatique (67 ans)",
        "Date d'effet possible (1er jour du mois suivant l'anniversaire)"
      ]
    },
    
    "etape_3_analyse_situation": {
      "comparaison": "Trimestres validés (projetés si en activité) vs Trimestres requis",
      "cas_possibles": {
        "cas_a_taux_plein": {
          "condition": "trimestres_valides >= trimestres_requis",
          "conclusion": "Départ possible au taux plein dès l'âge légal ou avant si carrière longue",
          "action": "Si carrière longue détectée : consulter SKILL_racl.md"
        },
        "cas_b_trimestres_manquants": {
          "condition": "trimestres_valides < trimestres_requis",
          "conclusion": "Calcul de la décote OU attente jusqu'à 67 ans"
        },
        "cas_c_depassement": {
          "condition": "trimestres_valides > trimestres_requis",
          "conclusion": "Calcul de la surcote possible"
        }
      }
    },
    
    "etape_4_scenarios_depart": {
      "scenario_1_age_legal": {
        "module": "calcul_pension_base.calculer_taux_liquidation",
        "formule_decote": {
          "decote_par_trimestre": 0.625,
          "description": "0,625% (soit 1,25% / 2)",
          "trimestres_manquants": "min(trimestres requis - validés, trimestres jusqu'à 67 ans)",
          "abattement": "Décote × Trimestres manquants (max 25%)",
          "taux_minore": "50% - Abattement",
          "taux_minimal": 37.5
        },
        "arbitrage_decote": "Le système prend automatiquement le moins défavorable entre décote par trimestres manquants pour taux plein et décote par âge"
      },
      "scenario_2_67_ans": {
        "taux_garanti": 50,
        "description": "Taux plein garanti (50%) quel que soit le nombre de trimestres",
        "avantage": "Aucune décote appliquée, pension calculée au prorata des trimestres validés"
      },
      "scenario_3_surcote": {
        "module": "calcul_pension_base.calculer_surcote",
        "formule": {
          "majoration_par_trimestre": 1.25,
          "description": "1,25% par trimestre de surcote",
          "taux_majore": "50% × (1 + Majoration)"
        }
      }
    },
    
    "etape_5_rachat_trimestres": {
      "module": "calcul_racl.calculer_cout_rachat_vplr",
      "periodes_rachetables": [
        "Années d'études supérieures (diplôme requis)",
        "Années incomplètes (< 4 trimestres)",
        "Maximum 12 trimestres au total",
        "Madelin : jusqu'à 24 trimestres pour indépendants"
      ],
      "options": [
        "taux_seul",
        "taux_et_duree"
      ],
      "impact": [
        "Départ au taux plein plus tôt",
        "Calcul de la nouvelle date de taux plein",
        "Avantage fiscal (déduction du revenu imposable)"
      ]
    },
    
    "etape_6_complementaires": {
      "agirc_arrco": {
        "module": "calcul_complementaires.calculer_pension_agirc_arrco",
        "formule": "Montant annuel brut = Points × Valeur du point (1,4386 €)",
        "valeur_point_2025": 1.4386,
        "malus_temporaire": "Supprimé depuis avril 2024",
        "pas_abattement_si": [
          "Départ à l'âge légal ou après ET taux plein",
          "Départ à 67 ans (taux plein auto)",
          "RACL (carrière longue avec taux plein)"
        ]
      },
      "ircantec": {
        "module": "calcul_complementaires.calculer_pension_ircantec",
        "formule": "Montant annuel = (Points A + Points B) × Valeur du point (0,56357 €)",
        "valeur_point_2025": 0.56357
      },
      "rci": {
        "module": "calcul_complementaires.calculer_pension_rci",
        "formule": "Montant annuel = (Points RCO × 1,200 €) + (Points RCI × 1,335 €)",
        "valeur_point_rco_2025": 1.200,
        "valeur_point_rci_2025": 1.335,
        "note": "Si décote : Appliquer abattement selon tableau dans REGIMES-COMPLEMENTAIRE-AGIRC_ARRCO.md"
      }
    }
  },
  
