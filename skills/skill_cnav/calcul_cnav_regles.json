{
  "skill_info": {
    "nom": "Calcul Pension CNAV",
    "code": "CNAV",
    "version": "1.0",
    "date_creation": "2025-01-10",
    "type": "skill_calcul_regime",
    "description": "Calcul pension BRUTE régime général - Sans scénarios fin de carrière"
  },
  
  "formule_officielle": {
    "source": "Article L.351-1 CSS",
    "formule": "Pension = SAM × Taux × (Trimestres RG / Trimestres requis)",
    "composants": {
      "sam": "Salaire Annuel Moyen (25 meilleures années)",
      "taux": "Taux de liquidation (37,5% à 75%)",
      "prorata": "Coefficient de proratisation (max 100%)"
    }
  },
  
  "valeurs_reglementaires_2025": {
    "ages": {
      "age_legal": 62,
      "age_taux_plein_auto": 67,
      "note": "Pour générations 1955 et suivantes"
    },
    "plafonds": {
      "plafond_ss_annuel": 47100,
      "plafond_ss_mensuel": 3925,
      "smic_horaire": 11.88,
      "smic_mensuel": 1801.84
    },
    "taux_liquidation": {
      "taux_plein": 50.0,
      "taux_minimal": 37.5,
      "decote_par_trimestre": 1.25,
      "surcote_par_trimestre": 1.25,
      "decote_maximale": 12.5,
      "trimestres_decote_max": 20
    },
    "prelevements_sociaux": {
      "csg": 8.3,
      "crds": 0.5,
      "casa": 0.3,
      "maladie": 0.1,
      "total": 9.2
    },
    "durees_assurance": {
      "1958_1960": 167,
      "1961_janv_aout": 168,
      "1961_sept_dec_1962": 169,
      "1963": 170,
      "1964": 171,
      "1965_et_apres": 172
    }
  },
  
  "regles_calcul": {
    "sam": {
      "description": "Salaire Annuel Moyen",
      "source": "Article R.351-29 CSS",
      "base_calcul": "Moyenne 25 meilleures années revalorisées",
      "plafonnement": "Limité au plafond SS de l'année",
      "fourni_par": "Relevé carrière ou calcul amont",
      "controle": "SAM <= Plafond_SS_annuel"
    },
    
    "taux_liquidation": {
      "description": "Taux de liquidation appliqué",
      "taux_plein": {
        "valeur": 50.0,
        "conditions": [
          "Durée assurance tous régimes >= Durée requise",
          "OU Âge >= 67 ans (taux plein auto)"
        ]
      },
      "decote": {
        "formule": "Taux = 50% - (Trimestres_manquants × 1,25%)",
        "trimestres_manquants": "MAX(0, Durée_requise - Trimestres_validés)",
        "limite": "Maximum 20 trimestres (12,5% décote)",
        "taux_minimal": 37.5
      },
      "surcote": {
        "formule": "Taux = 50% + (Trimestres_excedentaires × 1,25%)",
        "trimestres_excedentaires": "MAX(0, Trimestres_validés - Durée_requise)",
        "condition": "Activité après âge légal ET taux plein",
        "pas_de_limite": true
      }
    },
    
    "prorata": {
      "description": "Coefficient de proratisation",
      "formule": "Trimestres_cotisés_RG / Durée_requise_generation",
      "plafonnement": "MAX = 1,00 (100%)",
      "note": "Reflète la durée de cotisation au RG par rapport à la durée totale requise"
    }
  },
  
  "controles_coherence": [
    {
      "id": "CNAV_C01",
      "libelle": "SAM supérieur au plafond",
      "type": "ALERTE",
      "couleur": "ORANGE",
      "priorite": 2,
      "condition": {
        "expression": "sam > plafond_ss_annuel",
        "variables": {
          "sam": "float",
          "plafond_ss_annuel": 47100
        }
      },
      "regle_reglementaire": "Le SAM ne peut pas dépasser le plafond SS de l'année",
      "message": "SAM fourni ({sam}€) supérieur au plafond SS 2025 (47 100€). Vérifier ou plafonner.",
      "actions_correctives": [
        "verifier_sam_fourni",
        "appliquer_plafonnement_si_necessaire",
        "sam_plafonne = MIN(sam, 47100)"
      ],
      "impact": {
        "blocage": false,
        "correction_auto": true
      }
    },
    
    {
      "id": "CNAV_C02",
      "libelle": "Prorata supérieur à 100%",
      "type": "ALERTE",
      "couleur": "ORANGE",
      "priorite": 2,
      "condition": {
        "expression": "(trimestres_rg / duree_requise) > 1.00"
      },
      "regle_reglementaire": "Le coefficient de proratisation est plafonné à 100%",
      "message": "Prorata calculé : {prorata}% > 100%. Application plafonnement à 100%.",
      "actions_correctives": [
        "plafonner_prorata",
        "prorata = MIN(calcule, 1.00)"
      ],
      "impact": {
        "blocage": false,
        "correction_auto": true
      }
    },
    
    {
      "id": "CNAV_C03",
      "libelle": "Trimestres RG > Trimestres totaux",
      "type": "ERREUR_CRITIQUE",
      "couleur": "ROUGE",
      "priorite": 1,
      "condition": {
        "expression": "trimestres_rg > trimestres_valides_tous_regimes"
      },
      "regle_reglementaire": "Incohérence logique : trimestres régime <= trimestres totaux",
      "message": "Incohérence : Trimestres RG ({rg}) > Trimestres totaux ({total}). Vérifier données.",
      "actions_correctives": [
        "bloquer_calcul",
        "demander_verification_donnees",
        "verifier_releve_carriere"
      ],
      "impact": {
        "blocage": true
      }
    },
    
    {
      "id": "CNAV_C04",
      "libelle": "Taux hors limites réglementaires",
      "type": "ERREUR_CRITIQUE",
      "couleur": "ROUGE",
      "priorite": 1,
      "condition": {
        "expression": "taux < 37.5 OR taux > 75"
      },
      "regle_reglementaire": "Taux de liquidation entre 37,5% (décote max) et 75%",
      "message": "Taux calculé ({taux}%) hors limites [37,5% - 75%]. Vérifier paramètres.",
      "actions_correctives": [
        "bloquer_calcul",
        "verifier_parametres_calcul",
        "verifier_duree_requise",
        "verifier_trimestres_valides"
      ],
      "impact": {
        "blocage": true
      }
    },
    
    {
      "id": "CNAV_C05",
      "libelle": "SAM inférieur au SMIC annuel",
      "type": "VIGILANCE",
      "couleur": "JAUNE",
      "priorite": 3,
      "condition": {
        "expression": "sam < (smic_mensuel * 12)"
      },
      "regle_reglementaire": "SAM < SMIC annuel inhabituel, peut indiquer carrière incomplète",
      "message": "SAM ({sam}€) < SMIC annuel ({smic_annuel}€). Vérifier carrière.",
      "actions_correctives": [
        "alerter_consultant",
        "verifier_carriere_complete",
        "verifier_eligibilite_mico"
      ],
      "impact": {
        "blocage": false,
        "attention_particuliere": true
      }
    },
    
    {
      "id": "CNAV_C06",
      "libelle": "Génération hors périmètre",
      "type": "ERREUR_CRITIQUE",
      "couleur": "ROUGE",
      "priorite": 1,
      "condition": {
        "expression": "annee_naissance < 1958 OR annee_naissance > 2030"
      },
      "regle_reglementaire": "Durées d'assurance définies pour générations 1958-2030",
      "message": "Génération {annee} hors périmètre [1958-2030]. Impossible déterminer durée requise.",
      "actions_correctives": [
        "bloquer_calcul",
        "etendre_baremes_si_necessaire",
        "consulter_cas_particulier"
      ],
      "impact": {
        "blocage": true
      }
    }
  ],
  
