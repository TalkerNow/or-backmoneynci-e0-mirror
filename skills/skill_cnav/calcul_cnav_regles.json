        "trimestres_excedentaires": 8,
        "surcote": 10.0,
        "taux": 60.0,
        "prorata": 1.00
      },
      "resultat": {
        "pension_annuelle": 27000.00,
        "pension_mensuelle": 2250.00,
        "formule": "45000 × 0.60 × 1.00"
      }
    }
  ],
  
