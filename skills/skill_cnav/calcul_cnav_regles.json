      },
      {
        "code": "CNAV_A05",
        "libelle": "Prorata plafonné",
        "niveau": "ORANGE",
        "declencheur": "prorata > 1.00",
        "message": "Prorata plafonné à 100%",
        "action": "appliquer_plafonnement_informer",
        "urgence": "normale"
      }
    ],
    
    "jaune": [
      {
        "code": "CNAV_A06",
        "libelle": "SAM faible",
        "niveau": "JAUNE",
        "declencheur": "sam < smic_annuel",
        "message": "SAM inférieur au SMIC : vérifier carrière",
        "action": "alerter_consultant_verifier_mico",
        "urgence": "faible"
      },
      {
        "code": "CNAV_A07",
        "libelle": "Prorata faible",
        "niveau": "JAUNE",
        "declencheur": "prorata < 0.50",
        "message": "Prorata faible : carrière courte au RG",
        "action": "verifier_poly_pensionne",
        "urgence": "faible"
      },
      {
        "code": "CNAV_A08",
        "libelle": "Pension faible",
        "niveau": "JAUNE",
        "declencheur": "pension_mensuelle < 500",
        "message": "Pension CNAV faible : éligibilité MICO à vérifier",
        "action": "orienter_vers_calcul_mico",
        "urgence": "faible"
      }
    ]
  },
  
  "exemples_calcul": [
    {
      "numero": 1,
      "titre": "Cas standard taux plein",
      "type": "TAUX_PLEIN",
      "donnees": {
        "date_naissance": "20/04/1965",
        "sam": 42000.0,
        "trimestres_valides": 173,
        "trimestres_rg": 165,
        "age_depart": 63
      },
      "calculs": {
        "duree_requise": 172,
        "taux": 50.0,
        "prorata": 0.9593
      },
      "resultat": {
        "pension_annuelle": 20145.30,
        "pension_mensuelle": 1678.78,
        "formule": "42000 × 0.50 × 0.9593"
      }
    },
    
    {
      "numero": 2,
      "titre": "Cas avec décote",
      "type": "DECOTE",
      "donnees": {
