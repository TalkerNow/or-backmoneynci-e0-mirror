  "controles_coherence": [
    {
      "id": "RAC_C01",
      "nom": "Trimestres début activité insuffisants",
      "condition": "trimestres_debut_activite < trimestres_requis",
      "type": "ERREUR_CRITIQUE",
      "message": "Condition de début d'activité non remplie. {trimestres_debut_activite} trimestres validés, {trimestres_requis} requis avant fin année des {age_limite} ans"
    },
    {
      "id": "RAC_C02",
      "nom": "Trimestres cotisés insuffisants",
      "condition": "trimestres_cotises < duree_requise_taux_plein",
      "type": "ERREUR_CRITIQUE",
      "message": "Durée cotisée insuffisante. {trimestres_cotises} trimestres cotisés, {duree_requise_taux_plein} requis pour génération {annee_naissance}"
    },
    {
      "id": "RAC_C03",
      "nom": "Dépassement limite trimestres réputés cotisés",
      "condition": "trimestres_reputes_type > limite_type",
      "type": "AVERTISSEMENT",
      "message": "Dépassement limite {type_periode}. {trimestres_comptabilises} trimestres comptabilisés, maximum {limite} autorisés"
    },
    {
      "id": "RAC_C04",
      "nom": "Cumul >4 trimestres/an",
      "condition": "sum(trimestres_annee) > 4",
      "type": "ERREUR",
      "message": "Dépassement règle maximum 4 trimestres/an. Année {annee} : {total_trimestres} trimestres"
    },
    {
      "id": "RAC_C05",
      "nom": "Âge départ incohérent avec génération",
      "condition": "age_depart_calcule != age_depart_reglementaire",
      "type": "ERREUR",
      "message": "Âge de départ incohérent. Calculé : {age_depart_calcule}, Réglementaire : {age_depart_reglementaire}"
    },
    {
      "id": "RAC_C06",
      "nom": "Clause de sauvegarde non vérifiée",
      "condition": "generation IN [1961, 1962, 1963] AND NOT clause_sauvegarde_verifiee",
      "type": "AVERTISSEMENT",
      "message": "Clause de sauvegarde applicable (168 trimestres avant 01/09/2023). Vérifier si client peut en bénéficier"
    },
    {
      "id": "RAC_C07",
      "nom": "Rachat VPLR post-2011 compté à tort",
      "condition": "rachat_post_2011 AND option != 'taux_et_duree'",
      "type": "ERREUR",
      "message": "Rachat VPLR post-2011 ne compte que si option 'taux + durée'. Option actuelle : {option}"
    }
  ],
  
