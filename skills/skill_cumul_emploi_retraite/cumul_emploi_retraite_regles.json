      "type": "ALERTE",
      "couleur": "ORANGE",
      "priorite": 2,
      
      "condition": {
        "expression": "NOT EXISTS(activite_RG_MSA_speciaux IN periode_6_mois_avant_retraite)"
      },
      
      "regle_reglementaire": "Remonter à la dernière activité concernée pour établir période référence",
      "article": "Circulaire CNAV 2017-41 §2.3.1.1",
      
      "exemple_reglementaire": "Assuré RG 1965-1984 puis non-salarié : période = 3 derniers mois 1984",
      
      "message_alerte": "Aucune activité RG/MSA/Régimes spéciaux détectée dans les 6 mois précédant la retraite. Recherche de la dernière période d'activité concernée pour établir la période de référence.",
      
      "actions_correctives": [
        "remonter_historique_carriere",
        "identifier_derniere_activite_concernee",
        "demander_bulletins_salaire_periode_trouvee",
        "appliquer_revalorisation_si_ancienne"
      ],
      
      "impact": {
        "delai_supplementaire": true,
        "documents_justificatifs_anciens": true,
        "application_coefficient_revalorisation": true
      }
    },
    
    {
      "id": "CER_C08",
