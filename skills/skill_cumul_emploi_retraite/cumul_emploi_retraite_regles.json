{
  "skill_info": {
    "nom": "Cumul Emploi Retraite",
    "code": "CER",
    "version": "1.0",
    "date_creation": "2025-01",
    "source_reglementaire": "Circulaire CNAV n°2017-41 du 12 décembre 2017",
    "date_application": "2017-04-01",
    "description": "Règles de cumul entre retraite et activité professionnelle - mécanisme d'écrêtement"
  },
  
  "types_cumul": {
    "CER_TOTAL": {
      "code": "CER_TOTAL",
      "libelle": "Cumul Emploi Retraite Total",
      "description": "Cumul sans aucune restriction de revenus",
      "article_legal": "Art. L.161-22 al. 4 et 5 CSS",
      
      "conditions": {
        "mode": "cumulatif",
        
        "condition_1_subsidiarite": {
          "obligatoire": true,
          "description": "Liquidation de toutes retraites personnelles",
          "regimes_concernes": [
            "regimes_base_obligatoires",
            "regimes_complementaires_obligatoires",
            "regimes_francais",
            "regimes_etrangers",
            "legaux_ou_rendus_legalement_obligatoires"
          ],
          "article": "Art. L.161-22 al. 4 CSS",
          
          "exception": {
            "cas": "age_ouverture_regime_superieur_age_legal",
            "description": "Dérogation si âge ouverture sans décote > 62 ans",
            "application": "jusqu_age_sans_decote_du_regime",
            "consequence": "obligation_liquidation_a_cet_age_sinon_CER_PLAFONNE"
          }
        },
        
        "condition_2_age_duree": {
          "mode": "alternatif",
          "description": "Option A OU Option B",
          
          "option_a": {
            "libelle": "Âge légal + Taux plein",
            "conditions_cumulatives": {
              "age_legal": {
                "requis": true,
                "article": "Art. L.351-1 CSS",
                "valeur_generation_1955_plus": 62
              },
              "duree_taux_plein": {
                "requis": true,
                "description": "Durée assurance pour taux maximum 50%",
                "reference_tableau": "durees_assurance_par_generation"
              }
            }
          },
          
          "option_b": {
            "libelle": "Âge taux plein automatique",
            "age_requis": {
              "article": "Art. L.351-8 CSS",
              "valeur_generation_1955_plus": 67,
              "description": "Pas de condition de durée"
            }
          }
        }
      },
      
      "modalites_reprise": {
        "delai_dernier_employeur": 0,
        "delai_autre_employeur": 0,
        "immediat": true,
        "declaration_obligatoire": true,
        "motif_declaration": "controle_condition_subsidiarite"
      },
      
      "restrictions": {
        "limite_revenus": false,
        "plafond": null,
        "surveillance": "verification_subsidiarite_uniquement"
      }
    },
    
    "CER_PLAFONNE": {
      "code": "CER_PLAFONNE",
      "libelle": "Cumul Emploi Retraite Plafonné",
      "description": "Cumul autorisé dans une certaine limite de revenus",
      "article_legal": "Art. L.161-22 al. 2 et 3 CSS",
      
      "champ_application": {
        "condition_declenchement": "conditions_CER_TOTAL_non_remplies",
        
        "activites_concernees_par_plafond": {
          "regimes": [
            "regime_general",
            "regime_salaries_agricoles",
            "regimes_speciaux_L711_1"
          ],
          "regimes_speciaux_liste": [
            "IEG",
            "SNCF",
            "RATP",
            "Mines",
            "Banque_France",
            "CRPCEN",
            "Opera_Paris",
            "Comedie_Francaise",
            "Port_Strasbourg"
          ],
          "article": "Art. D.161-2-5 CSS"
        },
        
        "activites_libres_sans_limite": {
          "description": "Activités non soumises au plafond",
          "types": [
            "activites_non_salariees",
            "activites_salariees_autres_regimes",
            "activites_derogatoires_cessation"
          ],
          "reference": "Circulaire CNAV 2017-18 pour activités dérogatoires"
        }
      },
      
      "obligation_declaration": {
        "article": "Art. D.161-2-13 CSS",
        "delai_jours": 30,
        "unite": "mois_suivant",
        "mode": "ecrit",
        
        "evenements_declencheurs": [
          "reprise_activite",
          "modification_revenus_augmentation",
          "modification_revenus_diminution"
        ],
        
        "destinataire": {
          "regle_1": {
            "priorite": 1,
            "organisme": "dernier_regime_affiliation",
            "description": "Régime qui sert la pension au titre du dernier régime d'affiliation"
          },
          "regle_2": {
            "priorite": 2,
            "cas": "affiliation_simultanee",
            "organisme": "regime_plus_longue_duree_assurance",
            "reference": "Articles R.351-3 et R.351-4 CSS"
          }
        },
        
        "sanction_non_respect": {
          "consequence": "reduction_retroactive",
          "article": "Art. D.161-2-16 IV CSS",
          "description": "Application rétroactive au mois/trimestre du dépassement"
        }
      },
      
      "delai_dernier_employeur": {
        "article": "Art. D.161-2-12 et D.161-2-15 CSS",
        "duree_mois": 6,
        "obligation": "delai_6_mois_entre_date_effet_et_reprise",
        
        "definition_dernier_employeur": {
          "description": "Employeur auprès duquel assuré a travaillé dans 6 mois précédant date effet retraite",
          "periode_reference": "6_mois_avant_date_effet",
          "si_plusieurs_employeurs": "delai_s_applique_a_chacun"
        },
        
        "sanction_non_respect": {
          "type": "suspension_pension",
          "periode": {
            "debut": "1er_jour_mois_reprise",
            "fin": "dernier_jour_mois_cessation_activite_ou_fin_6eme_mois",
            "calcul_fin": "dernier_jour_6eme_mois_a_compter_date_effet_retraite"
          },
          "application": "meme_si_plafond_respecte",
          "note": "Suspension intervient indépendamment du respect du plafond"
        }
      },
      
      "calcul_plafond": {
        "article": "Art. D.161-2-5 et D.161-2-7 CSS",
        "principe": "limite_cumul_revenus_activite_plus_pensions",
        "formule": "MAX(methode_derniers_salaires, methode_smic)",
        
        "methode_derniers_salaires": {
          "code": "METHODE_A",
          "description": "Moyenne mensuelle salaires période de référence",
          
          "periode_reference": {
            "definition": "3_derniers_mois_activite",
            "composition": "mois_cessation_activite + 2_mois_civils_precedents",
            "regimes_concernes": [
              "regime_general",
              "regime_salaries_agricoles",
              "regimes_speciaux_L711_1"
            ],
            
            "cas_particuliers": {
              "activite_ancienne": {
                "condition": "pas_activite_concernee_dans_6_mois_avant_retraite",
                "action": "remonter_derniere_activite_concernee",
                "exemple": "Activité RG jusqu'en 1984 puis non-salarié : période = 3 derniers mois 1984"
              },
              
              "activite_1_mois": {
                "calcul": "revenus_ce_seul_mois",
                "sur_demande": true
              },
              
              "activite_2_mois": {
                "calcul": "moyenne_mensuelle_ces_2_mois",
                "sur_demande": true
              },
              
              "temps_partiel": {
                "calcul_standard": "salaires_temps_partiel_percus",
                "option_demande_assuree": {
                  "base": "salaire_temps_complet_entreprise",
                  "justificatif_requis": "attestation_employeur",
                  "description": "Démontrer revenu temps complet appliqué dans entreprise"
                }
              },
              
              "plusieurs_temps_partiels": {
                "regle": "total_remunerations >= remuneration_temps_complet_plus_eleve",
                "description": "Total ne peut être inférieur au temps complet le plus élevé",
                "justificatif": "attestation_employeur_pour_chaque_activite"
              },
              
              "affiliation_simultanee": {
                "periode_retenue": "celle_justifiee_dans_au_moins_1_regime_vise",
                "reference": "Art. D.161-2-5 CSS"
              }
            }
          },
          
          "revenus_a_retenir": {
            "base": "montants_bruts_soumis_CSG",
            "inclus": "toutes_sommes_assiette_CSG",
            "exclusions": [
              "salaires_activites_non_soumises_cessation"
            ],
            
            "option_indemnites_conges_payes": {
              "sur_demande": true,
              "action": "reaffectation_periode_reference",
              "description": "Indemnités CP peuvent être réaffectées à période référence"
            }
          },
          
          "revalorisation": {
            "article": "Art. D.161-2-8 CSS",
            "frequence": "annuelle",
            "modalite": "memes_conditions_revalorisation_pensions",
            "base_revalorisation": "regime_ayant_donne_lieu_cotisations",
            
            "si_plusieurs_regimes": {
              "regle": "revalorisation_regime_plus_longue_duree_assurance",
              "reference": "Articles R.351-3 et R.351-4 CSS"
            }
          }
        },
        
        "methode_smic": {
          "code": "METHODE_B",
          "article": "Art. D.161-2-9 CSS",
          "description": "160% du SMIC",
          
          "formule": {
            "coefficient": 1.6,
            "base": "smic_horaire_au_1er_janvier_annee_en_cours",
            "heures_annuelles": 1820,
            "calcul": "SMIC_horaire × 1.6 × (1820 / 12)"
          },
          
          "valeur_2025": {
            "smic_horaire_brut": 11.88,
            "calcul_detaille": "11.88 × 1.6 × 151.67",
            "plafond_mensuel_brut": 2873.76
          },
          
          "application": "si_methode_A_inferieure"
        },
        
        "plafond_retenu": {
          "regle": "maximum_des_deux_methodes",
          "formule": "MAX(METHODE_A, METHODE_B)"
        }
      },
      
      "revenus_a_comparer": {
        "article": "Art. L.161-22 al. 2 CSS, D.161-2-16, D.161-2-11 CSS",
        
        "revenus_activite": {
          "description": "Nouveaux revenus de la reprise d'activité",
          "base": "revenus_bruts_soumis_CSG",
          "article": "Art. D.161-2-5 CSS",
          
          "activites_incluses": [
            "regime_general",
            "regime_salaries_agricoles",
            "regimes_speciaux_L711_1"
          ],
          
          "activites_exclues": [
            "activites_derogatoires_cessation",
            "activites_autres_regimes"
          ]
        },
        
        "retraites_personnelles": {
          "description": "Pensions à prendre en compte",
          
          "regimes_inclus": {
            "base": [
              "regime_general",
              "regime_salaries_agricoles",
              "regimes_speciaux_L711_1"
            ],
            "complementaires_obligatoires": [
              "Arrco_Agirc",
              "Ircantec",
              "CRPNAC"
            ],
            "reference": "Livre IX CSS"
          },
          
          "montant": "brut",
          "exclusions": [
            "majoration_tierce_personne"
          ],
          
          "periodicite": {
            "si_pension_organismeechéance_mensuelle_et_autres_trimestrielles": {
              "base_calcul": "mensuelle"
            },
            "si_pension_organisme_echeance_trimestrielle_et_autres_mensuelles": {
              "base_calcul": "trimestrielle"
            },
            "prorata": "realiser_prorata_selon_periodes"
          }
        },
        
        "formule_comparaison": {
          "total": "revenus_activite + retraites_personnelles",
          "comparaison": "total <= plafond",
          "si_depassement": "ecretement_a_appliquer"
        }
      },
      
      "ecretement": {
        "article": "Art. D.161-2-16 CSS",
        "condition": "(revenus_activite + retraites) > plafond",
        
        "calcul_depassement": {
          "formule": "montant_depassement = (revenus_activite + retraites) - plafond"
        },
        
        "calcul_reduction": {
          "principe": "reduction_egale_montant_depassement",
          "application": "sur_chaque_pension_base",
          
          "pensions_concernees": [
            "pension_regime_general",
            "pension_regime_salaries_agricoles",
            "pensions_regimes_speciaux_L711_1"
          ],
          
          "regles": {
            "si_depassement_inferieur_montant_pension": {
              "montant_verse": "montant_pension - depassement"
            },
            "si_depassement_superieur_ou_egal_montant_pension": {
              "montant_verse": 0,
              "statut": "pension_suspendue"
            }
          }
        },
        
        "date_effet_reduction": {
          "article": "Art. D.161-2-16 III et IV CSS",
          
          "si_declaration_dans_delai": {
            "condition": "declaration <= (date_evenement + 1_mois)",
            "date_effet": "mois_suivant_notification_decision",
            "retroactivite": false
          },
          
          "si_declaration_hors_delai": {
            "condition": "declaration > (date_evenement + 1_mois)",
            "date_effet": "mois_ou_trimestre_du_depassement_reel",
            "retroactivite": true,
            "consequence": "recuperation_indu"
          }
        }
      },
      
      "fin_dispositif": {
        "article": "Art. D.161-2-16 III et V al. 2 CSS",
        
        "conditions_fin": [
          {
            "type": "respect_plafond",
            "condition": "(revenus + pensions) <= plafond",
            "effet": "cessation_reduction_mois_ou_trimestre_suivant"
          },
          {
            "type": "accession_CER_TOTAL",
            "condition": "conditions_CER_TOTAL_remplies",
            "effet": "1er_jour_mois_suivant_celui_remplit_conditions"
          }
        ]
      }
    }
  },
  
  "liaisons_inter_regimes": {
    "article": "Art. D.161-2-13 et D.161-2-18 CSS",
    
    "organisme_competent": {
      "critere_principal": "dernier_regime_affiliation",
      "exception_LURA": "sous_reserve_liquidation_unique",
      "si_affiliation_simultanee": "regime_plus_longue_duree_assurance_et_periodes_equivalentes"
    },
    
    "informations_transmises": [
      "noms_adresses_employeurs_ou_entreprises",
      "dates_debut_activites",
      "montant_nature_revenus_professionnels",
      "regimes_securite_sociale_affiliation",
      "bulletins_salaire_periode_reference",
      "documents_justificatifs_revenus_periode",
      "noms_adresses_autres_organismes_retraite",
      "pieces_justificatives_art_D161_2_7_II"
    ],
    
    "opposabilite_decision": {
      "principe": "decision_reduction_suspension_opposable_tous_regimes",
      "condition": "echeance_paiement_pensions_identique",
      "regimes_concernes": [
        "regime_general",
        "regime_salaries_agricoles",
        "regimes_speciaux",
        "regimes_complementaires"
      ]
    }
  },
  
  "controles_a_posteriori": {
    "article": "Art. D.161-2-14 et D.161-2-17 CSS",
    
    "obligations_caisses": {
      "moment_attribution": "rappel_obligation_declaration",
      "frequence": "annuelle",
      "action": "rappel_transmission_elements_reprise_activite"
    },
    
    "organisme_competent_controles": {
      "principe": "dernier_regime_affiliation",
      "exception": "sauf_LURA",
      "si_simultanee": "regime_plus_longue_duree"
    },
    
    "mise_en_oeuvre": {
      "verification_pour_chaque_echeance": [
        "respect_delai_6_mois_dernier_employeur",
        "respect_plafond_cumul"
      ],
      "application": "regles_suspension_et_reduction_pour_echeances_anterieures_controle"
    }
  },
  
  "cas_LURA": {
    "article": "Circulaire CNAV 2017-41 section 3",
    "principe": "regime_liquidateur_applique_propres_regles",
    
    "si_RSI_liquidateur": {
      "CER_plafonne_activite_salariee": false,
      "reduction": false,
      "controle_posteriori": false,
      "description": "Règles CER plafonné D.161-2-5+ non applicables"
    }
  },
  
  "controles_coherence": [
    {
      "id": "CER_C01",
      "libelle": "Âge légal non atteint",
      "type": "ERREUR_CRITIQUE",
      "couleur": "ROUGE",
      "priorite": 1,
      
      "condition": {
        "expression": "age_a_date_effet < age_legal AND demande_CER_TOTAL == true",
        "variables": {
          "age_a_date_effet": "calculer_age(date_naissance, date_effet_retraite)",
          "age_legal": 62,
          "demande_CER_TOTAL": "boolean"
        }
      },
      
      "regle_reglementaire": "CER TOTAL impossible avant âge légal (62 ans pour génération 1955+)",
      "article": "Art. L.351-1 CSS",
      
      "message_erreur": "L'assuré n'a pas atteint l'âge légal de {age_legal} ans. Le cumul emploi retraite total n'est pas autorisé. Âge actuel : {age_reel} ans.",
      
      "actions_correctives": [
        "bloquer_demande_CER_TOTAL",
        "proposer_CER_PLAFONNE",
        "calculer_date_eligibilite_age_legal"
      ],
      
      "impact": {
        "blocage": true,
        "orientation": "CER_PLAFONNE_obligatoire"
      }
    },
    
    {
      "id": "CER_C02",
      "libelle": "Subsidiarité non respectée",
      "type": "ERREUR_CRITIQUE",
      "couleur": "ROUGE",
      "priorite": 1,
      
      "condition": {
        "expression": "EXISTS(retraite_non_liquidee IN regimes_obligatoires) AND demande_CER_TOTAL == true AND NOT exception_age_ouverture",
        "variables": {
          "retraites_non_liquidees": "array",
          "exception_age_ouverture": "age_ouverture_regime > age_legal"
        }
      },
      
      "regle_reglementaire": "Liquidation ensemble retraites personnelles de TOUS régimes obligatoires",
      "article": "Art. L.161-22 al. 4 CSS",
      
      "citation": "obtenu l'ensemble de ses retraites personnelles auprès de la totalité des régimes légaux ou rendus légalement obligatoires de base et complémentaires, français ou étrangers",
      
      "message_erreur": "La condition de subsidiarité n'est pas respectée. Retraite(s) non liquidée(s) : {liste_regimes}. Le cumul emploi retraite total est refusé.",
      
      "actions_correctives": [
        "lister_regimes_manquants",
        "verifier_exception_age_ouverture",
        "bloquer_CER_TOTAL",
        "appliquer_CER_PLAFONNE"
      ],
      
      "exceptions": [
        {
          "cas": "age_ouverture_regime_superieur_age_legal",
          "action": "derogation_temporaire_jusqu_age_sans_decote"
        }
      ],
      
      "impact": {
        "blocage": true,
        "orientation": "CER_PLAFONNE_jusqu_liquidation_toutes_retraites"
      }
    },
    
    {
      "id": "CER_C03",
      "libelle": "Taux plein non atteint",
      "type": "ALERTE",
      "couleur": "ORANGE",
      "priorite": 2,
      
      "condition": {
        "expression": "age >= age_legal AND duree_assurance < duree_requise_taux_plein AND age < age_taux_plein_auto",
        "variables": {
          "age_legal": 62,
          "age_taux_plein_auto": 67,
          "duree_requise_taux_plein": "fonction(annee_naissance)"
        }
      },
      
      "regle_reglementaire": "Pour CER TOTAL : (âge légal + taux plein) OU (âge taux plein auto)",
      
      "message_alerte": "Âge légal atteint ({age} ans) mais durée d'assurance insuffisante ({duree_actuelle} trimestres sur {duree_requise} requis). CER PLAFONNÉ obligatoire jusqu'à {age_taux_plein_auto} ans ou obtention du taux plein.",
      
      "actions_correctives": [
        "basculer_automatiquement_CER_PLAFONNE",
        "calculer_trimestres_manquants",
        "indiquer_date_eligibilite_CER_TOTAL"
      ],
      
      "calculs_associes": {
        "trimestres_manquants": "duree_requise - duree_actuelle",
        "date_eligibilite_age": "date_67_ans",
        "date_eligibilite_duree": "estimer_date_taux_plein"
      },
      
      "impact": {
        "blocage": false,
        "orientation_forcee": "CER_PLAFONNE",
        "application_plafonds": true
      }
    },
    
    {
      "id": "CER_C04",
      "libelle": "Délai 6 mois non respecté",
      "type": "ERREUR_CRITIQUE",
      "couleur": "ROUGE",
      "priorite": 1,
      
      "condition": {
        "expression": "employeur_reprise IN employeurs_6_mois_avant_retraite AND delai_reprise < 6_mois AND mode_cumul == 'CER_PLAFONNE'",
        "variables": {
          "employeurs_6_mois_avant": "liste_employeurs_periode(date_effet - 6_mois, date_effet)",
          "delai_reprise": "calcul_mois(date_effet_retraite, date_reprise)"
        }
      },
      
      "regle_reglementaire": "Délai obligatoire 6 mois entre date effet et reprise chez dernier employeur",
      "article": "Art. D.161-2-12 et D.161-2-15 CSS",
      
      "citation": "Cette suspension intervient même si la limite de cumul n'est pas dépassée",
      
      "message_erreur": "Reprise chez le dernier employeur avant 6 mois : SUSPENSION OBLIGATOIRE du {date_debut} au {date_fin}. La pension sera suspendue même si le plafond de cumul est respecté.",
      
      "calcul_suspension": {
        "date_debut": "1er_jour_mois_reprise",
        "date_fin": "dernier_jour_6eme_mois_depuis_date_effet_OU_fin_activite",
        "formule": "MIN(fin_activite, date_effet + 6_mois)"
      },
      
      "actions_correctives": [
        "calculer_periode_suspension",
        "suspendre_pension_totalement",
        "recuperer_sommes_indument_versees",
        "notifier_assuree"
      ],
      
      "impact": {
        "blocage": true,
        "suspension_totale": true,
        "duree_suspension": "variable_selon_fin_activite",
        "aucune_alternative": true
      }
    },
    
    {
      "id": "CER_C05",
      "libelle": "Déclaration hors délai",
      "type": "ALERTE",
      "couleur": "ORANGE",
      "priorite": 2,
      
      "condition": {
        "expression": "date_declaration > (date_evenement + 1_mois)",
        "variables": {
          "date_evenement": "MAX(date_reprise, date_modification_revenus)",
          "delai_reglementaire": 30
        }
      },
      
      "regle_reglementaire": "Déclaration obligatoire dans le mois suivant reprise ou modification",
      "article": "Art. D.161-2-13 CSS",
      
      "consequence_retroactivite": {
        "article": "Art. D.161-2-16 IV CSS",
        "application": "reduction_retroactive_au_mois_ou_trimestre_depassement",
        "recuperation": "indu_depuis_date_depassement_reel"
      },
      
      "message_alerte": "Déclaration effectuée hors délai réglementaire (+{nb_jours} jours). Réduction RÉTROACTIVE appliquée à partir du {date_retroactive}. Montant indu à récupérer : {montant_indu}€.",
      
      "calculs": {
        "retard_jours": "date_declaration - (date_evenement + 30)",
        "date_application_retroactive": "debut_mois_ou_trimestre(date_evenement)",
        "montant_indu": "somme_reductions_periode_retroactive"
      },
      
      "actions_correctives": [
        "calculer_montant_indu",
        "appliquer_reduction_retroactive",
        "etablir_plan_recuperation",
        "notifier_assuree_consequences"
      ],
      
      "impact": {
        "penalite_financiere": true,
        "recuperation_retroactive": true,
        "possible_echelonnement": true
      }
    },
    
    {
      "id": "CER_C06",
      "libelle": "Dépassement plafond",
      "type": "VIGILANCE",
      "couleur": "JAUNE",
      "priorite": 3,
      
      "condition": {
        "expression": "(revenus_activite + total_pensions_brutes) > plafond_calcule"
      },
      
      "regle_reglementaire": "Écrêtement à due concurrence du dépassement",
      "article": "Art. D.161-2-16 CSS",
      
      "citation": "la retraite est réduite à due concurrence du dépassement",
      
      "message_alerte": "Plafond de cumul dépassé de {montant_depassement}€. Écrêtement à appliquer sur les pensions de base. Total revenus+pensions : {total}€ - Plafond : {plafond}€.",
      
      "calcul_ecretement": {
        "depassement": "(revenus_activite + pensions) - plafond",
        "pour_chaque_pension_base": {
          "reduction": "MIN(depassement, montant_pension)",
          "montant_verse": "MAX(0, montant_pension - reduction)",
          "si_reduction_superieure": "pension_suspendue"
        }
      },
      
      "actions_correctives": [
        "calculer_ecretement_detaille_par_regime",
        "notifier_assuree_nouveaux_montants",
        "proposer_reduction_activite",
        "calculer_seuil_eviter_ecretement"
      ],
      
      "impact": {
        "reduction_proportionnelle": true,
        "possible_suspension_totale": "si_depassement_superieur_pension",
        "reversible": "si_revenus_diminuent"
      }
    },
    
    {
