  "controles_coherence": [
    {
      "id": "VPL_C01",
      "nom": "Âge hors limites",
      "condition": "age < 20 OR age >= 67",
      "type": "BLOQUANT",
      "message": "Âge hors limites pour VPLR. Âge actuel : {age} ans. Limites : 20 à 66 ans inclus"
