      "nom": "Dépassement 12 trimestres",
      "condition": "trimestres_rachetes > 12",
      "type": "ERREUR",
      "message": "Dépassement limite réglementaire. {trimestres_rachetes} trimestres demandés, maximum 12 autorisés"
