    {
      "id": "VPL_C04",
      "nom": "Année déjà complète",
      "condition": "annee_incomplete AND trimestres_valides >= 4",
      "type": "IMPOSSIBLE",
      "message": "Rachat impossible. Année {annee} déjà validée à {trimestres_valides} trimestres (4 maximum)"
    },
    {
      "id": "VPL_C05",
      "nom": "Rentabilité négative",
      "condition": "duree_recuperation > 25",
      "type": "AVERTISSEMENT",
      "message": "Rentabilité très faible. Durée récupération : {duree_recuperation} ans (> 25 ans). Espérance vie à 62 ans : ~22-26 ans"
    },
    {
      "id": "VPL_C06",
      "nom": "Option sous-optimale",
      "condition": "option = 'taux_seul' AND trimestres_manquants_taux_plein > 0",
      "type": "SOUS-OPTIMAL",
      "message": "Option 'taux seul' alors que durée manquante pour taux plein. Option 'taux + durée' recommandée (impact maximal)"
    },
    {
      "id": "VPL_C07",
      "nom": "Rachat tardif sans analyse",
      "condition": "age > 60 AND NOT analyse_rentabilite",
      "type": "AVERTISSEMENT",
      "message": "Rachat après 60 ans détecté. Analyse rentabilité IMPÉRATIVE (coût élevé, espérance vie réduite)"
    }
  ],
  
