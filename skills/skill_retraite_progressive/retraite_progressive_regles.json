  "controles_coherence": [
    {
      "id": "RP_C01",
      "condition": "age_assure >= age_rp_minimal",
      "type": "ERREUR_CRITIQUE",
      "categorie": "ROUGE",
      "message": "Âge insuffisant. Âge minimum pour la RP : {age_rp} ans.",
      "action": "Bloquer la demande"
    },
    {
      "id": "RP_C02",
      "condition": "trimestres_tous_regimes >= 150",
      "type": "ERREUR_CRITIQUE",
      "categorie": "ROUGE",
      "message": "Durée d'assurance insuffisante. Il manque {x} trimestres pour atteindre 150.",
      "action": "Bloquer la demande"
    },
    {
      "id": "RP_C03",
      "condition": "40 <= quotite_travaillee <= 80",
      "type": "ERREUR_CRITIQUE",
      "categorie": "ROUGE",
      "message": "Quotité de travail hors limites ({quotite}%). Doit être entre 40 et 80%.",
      "action": "Bloquer la demande"
    },
    {
      "id": "RP_C04",
      "condition": "sam > 0",
      "type": "ERREUR_CRITIQUE",
      "categorie": "ROUGE",
      "message": "Salaire annuel moyen nul ou négatif. Vérifier la carrière.",
      "action": "Vérifier relevé de carrière"
    },
    {
      "id": "RP_C05",
      "condition": "37.5 <= taux <= 50",
      "type": "ERREUR_CRITIQUE",
      "categorie": "ROUGE",
      "message": "Taux hors limites ({taux}%). Vérifier calcul décote.",
      "action": "Recalculer le taux"
    },
    {
      "id": "RP_C06",
      "condition": "trimestres_rg > 0",
      "type": "ERREUR_CRITIQUE",
      "categorie": "ROUGE",
      "message": "Aucun trimestre au régime général.",
      "action": "Vérifier affiliation"
    },
    {
      "id": "RP_C07",
      "condition": "20 <= fraction_pension <= 60",
      "type": "ERREUR_CRITIQUE",
      "categorie": "ROUGE",
      "message": "Fraction pension hors limites ({fraction}%). Vérifier calcul quotité.",
      "action": "Recalculer la fraction"
    },
    {
      "id": "RP_C08",
      "condition": "modification_respecte_periode_annuelle",
      "type": "AVERTISSEMENT",
      "categorie": "ORANGE",
      "message": "Modification trop fréquente. Attendre la période annuelle suivante.",
      "action": "Informer sur règle de modification"
    },
    {
      "id": "RP_C09",
      "condition": "questionnaire_renvoye",
      "type": "AVERTISSEMENT",
      "categorie": "ORANGE",
      "message": "Questionnaire de contrôle non renvoyé. Risque de suspension.",
      "action": "Relancer l'assuré"
    },
    {
      "id": "RP_C10",
      "condition": "activite_conforme_limites",
      "type": "AVERTISSEMENT",
      "categorie": "ORANGE",
      "message": "Activité hors limites. Risque de suppression de la RP.",
      "action": "Alerter l'assuré"
    },
    {
      "id": "RP_C11",
      "condition": "pension_definitive >= pension_provisoire_revalorisee",
      "type": "VERIFICATION",
      "categorie": "VERT",
      "message": "Règle du montant minimal respectée.",
      "action": "Validation OK"
    },
    {
      "id": "RP_C12",
      "condition": "conditions_cumul_verifiees",
      "type": "INFORMATION",
      "categorie": "BLEU",
      "message": "Cumul emploi-retraite possible après liquidation définitive.",
      "action": "Informer l'assuré"
    }
  ],
  
