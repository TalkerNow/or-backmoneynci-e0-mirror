{
  "skill_info": {
    "nom": "Retraite Progressive (RP)",
    "version": "1.0",
    "date": "2025-11-10",
    "description": "Dispositif d'aménagement de fin de carrière permettant de cumuler activité à temps partiel et fraction de pension provisoire",
    "source_reglementaire": "CSS L.351-15, L.351-16 | Décret 2017-1645 | Circulaire CNAV 2018-31"
  },
  
  "declencheurs": [
    "retraite progressive",
    "RP",
    "temps partiel retraite",
    "mi-temps fin carrière",
    "réduire activité",
    "travailler à 80% et toucher pension",
    "cumul temps partiel pension",
    "transition progressive",
    "retraite partielle"
  ],
  
  "conditions_eligibilite": {
    "condition_1_age": {
      "description": "Âge minimum : âge légal - 2 ans, sans être inférieur à 60 ans",
      "formule": "age_rp = max(age_legal - 2, 60)",
      "controle_id": "RP_C01",
      "exemples": {
        "_source": "Circulaire Cnav 2026-07 du 05/03/2026 (loi n°2025-1403 du 30/12/2025 — suspension de la réforme 2023). Effet retraite ≥ 01/09/2026.",
        "generation_1962": {
          "age_legal": "62 ans 6 mois",
          "age_rp": "60 ans 6 mois"
        },
        "generation_1964": {
          "age_legal": "62 ans 9 mois",
          "age_rp": "60 ans 9 mois"
        },
        "generation_1965_avril_dec": {
          "age_legal": "63 ans",
          "age_rp": "61 ans"
        },
        "generation_1969_et_apres": {
          "age_legal": "64 ans",
          "age_rp": "62 ans"
        }
      }
    },
    
    "condition_2_duree": {
      "description": "Durée d'assurance minimale tous régimes confondus",
      "trimestres_requis": 150,
      "regimes_comptabilises": [
        "CNAV (régime général)",
        "MSA salariés",
        "MSA non-salariés",
        "RSI/SSI (artisans, commerçants)",
        "CIPAV et professions libérales",
        "Régimes spéciaux (depuis 2015)"
      ],
      "periodes_comptabilisees": [
        "Trimestres cotisés",
        "Trimestres assimilés",
        "Périodes reconnues équivalentes (PRE)",
        "Périodes étrangères (UE, conventions bilatérales)"
      ],
      "controle_id": "RP_C02"
    },
    
    "condition_3_temps_partiel": {
      "description": "Activité salariée à temps partiel entre 40% et 80%",
      "quotite_min": 40,
      "quotite_max": 80,
      "formule": "quotite = (heures_temps_partiel / heures_temps_complet) × 100",
      "multi_employeurs_autorise": true,
      "depuis": "2018-01-01",
      "controle_id": "RP_C03",
      
      "exclusions": {
        "description": "Salariés dont la durée n'est pas exprimée en heures",
        "liste": [
          "VRP (sauf horaire précis)",
          "Mandataires sociaux / dirigeants",
          "Forfait jours sur l'année",
          "Artisans-taxis affiliés assurance volontaire"
        ]
      },
      
      "cas_particuliers": {
        "particuliers_employeurs": {
          "duree_conventionnelle": 40,
          "unite": "heures/semaine",
          "reference": "CCN 24/11/1999 art. 15-a"
        },
        "assistantes_maternelles": {
          "duree_conventionnelle": 45,
          "unite": "heures/semaine",
          "calcul": "Nombre moyen d'heures d'accueil par contrat",
          "reference": "CCN 01/07/2004 art. 6"
        }
      }
    }
  },
  
  "calcul_fraction_pension": {
    "etape_1_montant_entier": {
      "description": "Calcul provisoire de la pension entière",
      "formule": "pension_entiere = SAM × taux × (trimestres_rg / trimestres_requis)",
      "date_arret_compte": "Dernier jour du trimestre civil précédant la date d'effet",
      "decote_plafonnee": {
        "description": "Coefficient de minoration plafonné à 25% (au lieu de 37,5%)",
        "loi": "Loi 2014-40 du 20/01/2014",
        "formule": "abattement_max = min(trimestres_manquants × 0.625%, 25%)"
      },
      "avantages_applicables": [
        "Majoration pour enfants (10%)",
        "Surcote (si applicable)",
        "Majoration handicapé lourd",
        "Minimum contributif"
      ],
      "avantages_non_applicables": [
        "ASPA (allocation solidarité personnes âgées)"
      ],
      "controles": ["RP_C04", "RP_C05", "RP_C06"]
    },
    
    "etape_2_pourcentage_fractionnement": {
      "description": "Calcul de la fraction de pension versée",
      "formule": "fraction_pension = 100 - quotite_travaillee",
      "exemples": {
        "quotite_40": { "travail": 40, "pension": 60 },
        "quotite_50": { "travail": 50, "pension": 50 },
        "quotite_60": { "travail": 60, "pension": 40 },
        "quotite_70": { "travail": 70, "pension": 30 },
        "quotite_80": { "travail": 80, "pension": 20 }
      },
      "controle_id": "RP_C07"
    },
    
    "etape_3_montant_verse": {
      "description": "Montant mensuel de la retraite progressive",
      "formule": "montant_rp = pension_entiere × (fraction_pension / 100)"
    }
  },
  
